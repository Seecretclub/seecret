# SEEcret — variables d'environnement (sans secrets)
# Copiez ce fichier en `.env` et remplissez les valeurs.

# Serveur / CRM
PORT=3157

# Email (envoi des emails CRM)
# En production (Railway, etc.), le SMTP sortant est souvent bloqué par
# l'hébergeur : utilisez RESEND_API_KEY (prioritaire). EMAIL_USER/EMAIL_PASS
# restent utiles en local où le SMTP Gmail fonctionne normalement.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@seecret.fr
EMAIL_USER=votre_email@example.com
EMAIL_PASS=votre_mot_de_passe

# Apify (scraping, optionnel)
APIFY_TOKEN=

# Moteur Python IMMO DATA ROBOT (projet séparé : immo-data-robot-foundation)
ROBOT_URL=http://127.0.0.1:8000
ROBOT_USER=robot@seecret.club
ROBOT_PASS=

# Fournisseurs d'enrichissement (optionnels)
PAPPERS_API_KEY=
EXA_API_KEY=
LUSHA_API_KEY=
HUNTER_API_KEY=
DROPCONTACT_API_KEY=
