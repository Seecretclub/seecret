# SEEcret — variables d'environnement (sans secrets)
# Copiez ce fichier en `.env` et remplissez les valeurs.

# Serveur / CRM
PORT=3157

# Email (envoi des emails CRM)
# En production (Railway, etc.), le SMTP sortant est souvent bloqué par
# l'hébergeur : utilisez RESEND_API_KEY (prioritaire). EMAIL_USER/EMAIL_PASS
# restent utiles en local où le SMTP Gmail fonctionne normalement.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@seecret.fr
EMAIL_USER=votre_email@example.com
EMAIL_PASS=votre_mot_de_passe

# Apify (scraping, optionnel)
APIFY_TOKEN=

# Fichier DVF (ValeursFoncieres-*.txt, ~500 Mo) utilisé pour l'historique des
# mutations foncières et la valorisation interne. En local, pointez vers le
# fichier du projet immo-data-robot-foundation. En production, montez-le sur
# un volume (ou un stockage externe) et indiquez son chemin ici — si la
# variable n'est pas définie, ces deux fonctionnalités échoueront proprement.
DVF_PATH=

# Moteur Python IMMO DATA ROBOT (projet séparé : immo-data-robot-foundation)
ROBOT_URL=http://127.0.0.1:8000
ROBOT_USER=robot@seecret.club
ROBOT_PASS=

# Célia — l'assistante conversationnelle et vocale du CRM (bulle en bas à
# droite). Deux fournisseurs d'IA possibles, au choix :
#
#   OPTION GRATUITE (recommandée) — API Gemini de Google, sans carte bancaire :
#   1. aistudio.google.com → se connecter → "Get API key" → "Create API key"
#   2. coller la clé ci-dessous dans GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE=
#
#   OPTION PAYANTE — API Anthropic (Claude), facturée à l'usage (carte requise) :
#   console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_BASE=
#
# AI_PROVIDER force explicitement le fournisseur ('gemini' ou 'anthropic') si
# les deux clés sont renseignées ; sinon, Gemini est utilisé dès que
# GEMINI_API_KEY est présente, Anthropic sinon.
AI_PROVIDER=

# Fournisseurs d'enrichissement (optionnels)
PAPPERS_API_KEY=
EXA_API_KEY=
LUSHA_API_KEY=
HUNTER_API_KEY=
DROPCONTACT_API_KEY=

# Adresse publique du site (domaine). Sert aux liens envoyés par email et aux
# Passkeys (Face ID / Touch ID), qui sont liées à ce domaine.
PUBLIC_URL=

# Identité de l'agence imprimée dans le mandat de recherche signé en ligne.
# Les 4 premières sont obligatoires : sans elles, aucun mandat n'est proposé.
AGENCE_RAISON_SOCIALE=
AGENCE_ADRESSE=
AGENCE_CARTE_T=
AGENCE_GARANTIE=
AGENCE_FORME=
AGENCE_SIREN=
AGENCE_RCP=
AGENCE_REPRESENTANT=
# Barème (en %, TTC) et assiette des honoraires repris dans le mandat
AGENCE_TAUX_ACQUEREUR=5
AGENCE_TAUX_MIXTE=3
AGENCE_ASSIETTE=du prix de vente du bien hors honoraires (prix net vendeur)
AGENCE_NON_CONTOURNEMENT_MOIS=12

# Fichier DGFiP des locaux des personnes morales : 0 = pas d'import automatique
PM_AUTO_IMPORT=0
PM_DEPTS=75,92,94
